  "query": "\n            SELECT\n                logs.block_hash,\n                logs.transaction_index,\n                logs.log_index,\n                logs.tx_hash,\n                logs.address,\n                logs.topics,\n                logs.data,\n                logs.decoded_event,\n                logs.decoder_version\n            FROM logs\n            WHERE logs.chain_id = ($1::text)::numeric\n            ORDER BY logs.block_number, logs.transaction_index, logs.log_index\n            ",
